#!/usr/bin/env python3
import sys

db = {
    "megacloudcorp": [
        "[*] Searching DNS records...",
        "  -> www.megacloudcorp.com (192.0.2.1)",
        "  -> mail.megacloudcorp.com (192.0.2.5)",
        "[*] Searching public code repositories...",
        "  -> 0 results found.",
        "[*] Searching public bucket databases...",
        "  -> Found bucket: megacloudcorp-public-backup",
        "[*] Recon complete."
    ]
}

if len(sys.argv) < 2:
    print("Usage: recon_tool <target_name>")
    sys.exit(1)

target = sys.argv[1].lower()
if target in db:
    for line in db[target]:
        print(line)
else:
    print(f"[*] Searching for {target}...")
    print("  -> 0 results found.")
