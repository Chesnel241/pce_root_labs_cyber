# --- docker-compose (racine) — variables d'environnement ---
# Copiez en `.env` à la racine du dépôt avant `docker compose up`.

# PostgreSQL
POSTGRES_USER=pce
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=pce_labs

# Backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
LAB_TTL_MINUTES=60
FLAG_PREFIX=PCE

# Origine(s) frontend autorisée(s) (CORS). Le frontend Vercel, par ex.
CORS_ORIGIN=https://app.example.com

# Hôtes Traefik (routage)
API_HOST=api.example.com
APP_HOST=app.example.com
