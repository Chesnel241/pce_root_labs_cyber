# --- PCE Root Labs Cyber — Backend configuration ---
# Copy this file to `.env` and adjust the values for your environment.

# HTTP port the API listens on.
PORT=4000

# PostgreSQL connection string. Leave EMPTY to run in degraded (read-only)
# mode: the curriculum is still served from data/curriculum.json, but auth
# and progress endpoints return 503 "database not configured".
# Example: postgres://pce:pce@localhost:5432/pce_labs
DATABASE_URL=

# Secret used to sign JWTs. MUST be set to a long random string in production.
# In development a default is used if this is left empty (a warning is logged).
JWT_SECRET=

# JWT lifetime (vercel/zeit ms format, e.g. 7d, 12h, 3600).
JWT_EXPIRES_IN=7d

# Allowed CORS origin (the frontend). Comma-separated list is supported.
CORS_ORIGIN=http://localhost:3000

# Docker daemon socket used to orchestrate lab containers. If Docker is not
# reachable, lab endpoints degrade gracefully (503) instead of crashing.
DOCKER_SOCKET=/var/run/docker.sock

# Default time-to-live (minutes) of a running lab session before auto-stop.
LAB_TTL_MINUTES=60

# Flag prefix. Flags look like PCE{...}.
FLAG_PREFIX=PCE
