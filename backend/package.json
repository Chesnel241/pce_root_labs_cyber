{
  "name": "pce-root-labs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API + lab orchestrator for PCE Root Labs Cyber (CTF-style cloud security training platform).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
