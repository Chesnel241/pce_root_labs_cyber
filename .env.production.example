# =============================================================================
# PCE Root Labs Cyber — variables d'environnement de PRODUCTION (modèle)
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env` à la racine du dépôt SUR LE VPS, puis renseignez
# des valeurs réelles. NE COMMITTEZ JAMAIS le `.env` (il est déjà gitignoré).
#
#   cp .env.production.example .env
#   nano .env   # remplissez les valeurs ci-dessous
#
# Aucun secret réel ne figure ici : ce ne sont que des PLACEHOLDERS.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Identifiants de la base. Le mot de passe DOIT être long et aléatoire en prod.
# Générer : openssl rand -hex 24
POSTGRES_USER=pce
POSTGRES_PASSWORD=REMPLACEZ_par_un_mot_de_passe_long_et_aleatoire
POSTGRES_DB=pce_labs

# DATABASE_URL est dérivé automatiquement dans docker-compose.yml à partir des
# variables POSTGRES_* ci-dessus (hôte interne `postgres`). Ne le redéfinissez
# que si vous utilisez une base externe (ex. Supabase). Format :
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=postgres://pce:motdepasse@postgres:5432/pce_labs

# --- Backend (API + WS + orchestrateur de labs) -------------------------------
# Secret de signature des JWT. OBLIGATOIRE en production.
# Générer : openssl rand -hex 32
JWT_SECRET=REMPLACEZ_par_une_chaine_aleatoire_de_64_caracteres
JWT_EXPIRES_IN=7d

# Durée de vie (minutes) d'une session de lab avant arrêt automatique (TTL).
LAB_TTL_MINUTES=60

# Préfixe des flags CTF (PCE{...}).
FLAG_PREFIX=PCE

# Origine(s) frontend autorisée(s) pour CORS. METTEZ ICI le domaine Vercel exact
# du frontend (sans slash final). Plusieurs valeurs possibles en CSV.
#   ex. https://app.votre-domaine.tld
CORS_ORIGIN=https://app.example.com

# --- Traefik (reverse proxy / TLS) -------------------------------------------
# Hôte public de l'API backend (enregistrement DNS A vers l'IP du VPS).
API_HOST=api.example.com
# Hôte public du frontend (utilisé uniquement si vous self-hostez le frontend ;
# sur Vercel ce domaine est géré côté Vercel).
APP_HOST=app.example.com

# Adresse e-mail pour les certificats Let's Encrypt (notifications d'expiration).
# NB : à reporter AUSSI dans traefik/traefik.yml (pas de substitution auto).
ACME_EMAIL=admin@example.com
